APP_NAME=PulseReach API
DATABASE_URL=postgresql+psycopg://pulsereach:change-me@localhost:5432/pulsereach
CORS_ORIGINS=http://localhost:3000
DATA_SOURCE=memory
# Optional AI assistance (off by default; deterministic templates when off or failing).
# Copy to backend/.env (git-ignored, never commit it). LLM_PROVIDER: openai_compatible | anthropic | gemini
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
# Model id; for gemini it overrides GEMINI_MODEL when set.
LLM_MODEL=
# openai_compatible / anthropic only (gemini ignores both).
LLM_BASE_URL=
LLM_API_KEY=
# Per attempt / transient retries (timeouts, network, 429, 5xx) / overall budget.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TOTAL_TIMEOUT_SECONDS=45
# Use 1024 for gemini (thinking tokens count against the budget).
LLM_MAX_OUTPUT_TOKENS=400
# Native Google Gemini API (LLM_ENABLED=true + LLM_PROVIDER=gemini); docs/ai-gemini.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# empty (model default) | minimal | low | medium | high
GEMINI_THINKING_LEVEL=
