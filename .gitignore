# Env / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
.DS_Store

# Datasets.
# Default: ignore everything under data/, then re-admit documentation, the source
# manifest, small verified public source files, and small synthetic demo fixtures.
# Large generated output (full synthetic populations, Synthea output, processed
# intermediates, NHANES XPT files) stays out of git.
data/**/*
!data/**/
!data/**/.gitkeep

# Documentation and provenance (always committed)
!data/README.md
!data/metadata/*.md
!data/reference/source_manifest.yaml
!data/reference/raw_checksums.sha256

# Verified public official source files, acquired in Phase 2.5 and checksummed in
# data/reference/raw_checksums.sha256. ~20 MB total: public aggregate government
# statistics under licences permitting redistribution with attribution. Committed so
# the data foundation is reproducible without re-hitting undocumented portal APIs
# that may change or disappear.
!data/raw/scad/*.xlsx
!data/raw/statad_api/*.json
!data/raw/statad_api/indicator_detail/*.json
!data/raw/statad_api/indicator_metadata/*.xlsx
!data/raw/abudhabi_sdi/*.geojson
!data/raw/abudhabi_sdi/*.json
!data/raw/abudhabi_opendata/*.json
!data/raw/abudhabi_opendata/metadata/*.json
!data/raw/abudhabi_opendata/files/*.xlsx

# Small synthetic demo fixtures and data cards (not full populations)
!data/synthetic/fixtures/**
!data/synthetic/**/data_card.md

# Large or regenerable datasets — excluded even inside the paths re-admitted above
data/raw/nhanes/
data/synthetic/synthea/
data/synthetic/pulsereach/
data/reference/doh_standards/

# processed/ is regenerable from raw/ + committed code, so it stays out of git.
# One exception is re-admitted at the end of this file.
data/processed/**

*.csv
*.parquet
*.sqlite3
*.db

# Re-admit committable fixtures last, so the blanket *.csv rule above cannot
# re-exclude them (later patterns win in gitignore).
!data/synthetic/fixtures/**

# The facility transformation's quality report: small, and the provenance record for
# data/processed/ (carries the output SHA-256, per-layer counts and field cautions).
# Must come after both `data/processed/**` and the blanket `*.json`-adjacent rules —
# later patterns win. The CSV it describes stays ignored and is regenerated by
# data-pipeline/transformation/build_facilities.py.
!data/processed/facilities/
!data/processed/facilities/quality_report.json

# ML artifacts
ml/**/*.pkl
ml/**/*.joblib
ml/**/*.pt

# Claude Code local settings
.claude/settings.local.json
