# Used by docker-compose.yml (infrastructure/)
POSTGRES_USER=pulsereach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulsereach
# Backend data source for the API container: db (default) or memory
DATA_SOURCE=db
# Shared demo access code for state-changing requests (header X-PulseReach-Write-Key).
# Generate e.g. `openssl rand -hex 16`. Without it, writes are refused unless
# ALLOW_UNPROTECTED_WRITES=true (local development only, never in a public deployment).
WRITE_API_KEY=
ALLOW_UNPROTECTED_WRITES=false
# Optional AI assistance (off by default; deterministic templates are used when off or failing)
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
