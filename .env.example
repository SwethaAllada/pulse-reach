# Used by docker-compose.yml (infrastructure/)
POSTGRES_USER=pulsereach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulsereach
# Backend data source for the API container: db (default) or memory
DATA_SOURCE=db
# Access control: users (default; bearer tokens, RBAC, organization isolation) or legacy
# (shared write key below; frontend migration only). Create the first administrator with
# `python -m app.services.identity create-admin` (password prompted; never stored here).
AUTH_MODE=users
SELF_REGISTRATION_ENABLED=true
# Proxies that append to X-Forwarded-For in front of the API (Cloud Run: 1). 0 = socket peer.
TRUSTED_PROXY_HOPS=0
DEFAULT_LOCALE=en
# Legacy mode only — shared demo access code for state-changing requests (header X-PulseReach-Write-Key).
# Generate e.g. `openssl rand -hex 16`. Without it, writes are refused unless
# ALLOW_UNPROTECTED_WRITES=true (local development only, never in a public deployment).
WRITE_API_KEY=
ALLOW_UNPROTECTED_WRITES=false
# Optional AI assistance (off by default; deterministic templates are used when off or failing).
# Provider is exactly LLM_PROVIDER: openai_compatible | anthropic | gemini (no silent switching).
# Never commit a filled-in copy of this file; keys never go to the frontend or NEXT_PUBLIC_*.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
# Model id; for gemini it overrides GEMINI_MODEL when set (leave empty to use GEMINI_MODEL).
LLM_MODEL=
# openai_compatible / anthropic only (empty = provider default; ignored by gemini).
LLM_BASE_URL=
# openai_compatible / anthropic only (gemini uses GEMINI_API_KEY).
LLM_API_KEY=
# Per-attempt timeout, retries of transient failures only (timeouts, network, 429, 5xx) and the
# overall budget for all attempts plus backoff.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TOTAL_TIMEOUT_SECONDS=45
# 1024 recommended for gemini (thinking tokens count against it; truncation -> deterministic fallback).
LLM_MAX_OUTPUT_TOKENS=400
# Native Google Gemini API (LLM_ENABLED=true + LLM_PROVIDER=gemini). See docs/ai-gemini.md.
# Key from Google AI Studio; on Cloud Run it comes from Secret Manager (pulsereach-gemini-api-key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional thinking level: empty (model default) | minimal | low | medium | high
GEMINI_THINKING_LEVEL=
