# Used by docker-compose.yml (infrastructure/)
POSTGRES_USER=pulsereach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulsereach
# Backend data source for the API container: db (default) or memory
DATA_SOURCE=db
# Optional AI assistance (off by default; deterministic templates are used when off or failing)
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
